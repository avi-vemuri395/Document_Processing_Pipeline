# API Keys
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Google Document AI Configuration
GOOGLE_CLOUD_PROJECT=YOUR-PROJECT-ID          # Your GCP project ID
GOOGLE_CLOUD_LOCATION=us                      # Options: us or eu
DOCAI_FORM_PARSER_ID=YOUR-FORM-PARSER-ID     # Form Parser processor ID (preferred)
DOCAI_GENERAL_PROCESSOR_ID=YOUR-PROCESSOR-ID  # General processor ID (fallback)
DOCAI_USE_IMAGELESS_MODE=false               # Enable for 30-page limit (requires Google allowlist)
DOCAI_TIMEOUT=120                             # Timeout in seconds
DOCAI_MAX_RETRIES=3                          # Max retry attempts

# Files API Configuration (TEST)
USE_FILES_API=false              # Set to true to test Files API
FILES_TTL_DAYS=7                 # Days to keep files in cache
MAX_IMAGE_DIM=1900               # Max image dimension for API
IMAGES_PER_CALL=8                # Images per API call
JPEG_QUALITY=80                  # JPEG compression quality
HYBRID_PDF_MODE=true             # Use both document and image blocks for PDFs

# Debug Settings
DEBUG_VERBOSE=false              # Verbose logging